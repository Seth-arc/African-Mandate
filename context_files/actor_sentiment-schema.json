{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "actor-sentiment.schema.json",
    "type": "object",
    "required": [
        "actor_key",
        "sentiment"
    ],
    "properties": {
        "actor_key": {
            "type": "string",
            "enum": [
                "auCommissioner",
                "goita",
                "jnim",
                "ecowas",
                "tuareg",
                "burkinaJunta",
                "burkinaCivil",
                "nigerJunta",
                "nigerHumanitarian",
                "chadTransitional",
                "mauritaniaIntel",
                "wagner"
            ]
        },
        "sentiment": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
        }
    },
    "additionalProperties": false
}