            "cutscenes": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "cutsceneId": { "type": "string" },
                  "description": { "type": "string" },
                  "languages": { "type": "array", "items": { "type": "string" } },
                  "media": { "type": "string" }
                }
              }
            }
          }
        },
        "metricsHistory": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "turn": { "type": "integer" },
              "region": { "type": "string" },
