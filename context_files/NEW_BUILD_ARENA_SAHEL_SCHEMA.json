          "type": "object",
          "properties": {
            "turns": { "type": "integer" },
            "urgencyWindows": { "type": "array", "items": { "type": "string" } }
          }
        },
        "specialAssets": {
          "type": "array",
          "items": { "type": "string" }
        },
        "resourceFlows": {
          "type": "object",
          "properties": {
            "earned": { "type": "array", "items": { "type": "string" } },
            "spent": { "type": "array", "items": { "type": "string" } },
            "lost": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
