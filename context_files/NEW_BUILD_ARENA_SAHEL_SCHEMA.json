{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Sahel Arena Game Schema",
  "description": "Schema for African Mandate: Sahel Arena game structure, narrative, and technical requirements.",
  "type": "object",
  "properties": {
                "glossary": {
                  "type": "object",
                  "description": "Glossary of schema items for Sahel Arena Game.",
                  "properties": {
                    "gameTitle": { "type": "string", "description": "Title of the game." },
                    "executiveSummary": { "type": "string", "description": "Brief overview of the Sahel crisis and game objectives." },
                    "threatEnvironment": { "type": "string", "description": "Threat level and regional average score." },
                    "gameStructure": { "type": "string", "description": "Game acts, branching paths, endings, save system, and tutorial." },
                    "resources": { "type": "string", "description": "Financial, human, political, material, intelligence, time, and special assets." },
                    "actors": { "type": "string", "description": "Profiles of state, non-state, community, and external actors." },
                    "territories": { "type": "string", "description": "Geographic regions with threat levels, metrics, assets, and incidents." },
                    "threatClassification": { "type": "string", "description": "Threat level scoring and response priorities." },
                    "assetClassification": { "type": "string", "description": "Strategic asset types, values, and intervention leverage." },
                    "userExperience": { "type": "string", "description": "Onboarding, situation room, and UI/UX elements." },
                    "turnMechanics": { "type": "string", "description": "Turn-based logic, urgency windows, and time-based events." },
                    "scenarioItems": { "type": "string", "description": "Scenario-specific items and one-time assets." },
                    "resourceAllocation": { "type": "string", "description": "Resource allocation decisions, trade-offs, and consequences." },
                    "actorRelationships": { "type": "string", "description": "Dynamic relationships, alliances, and influence networks." },
                    "narrative": { "type": "string", "description": "Narrative sequences, cutscenes, and multi-language content." },
                    "metricsHistory": { "type": "string", "description": "Historical tracking of metrics by turn and region." },
                    "uiUx": { "type": "string", "description": "UI/UX elements such as modals, slides, and maps." },
                    "eventTriggers": { "type": "string", "description": "Event triggers, conditions, and branching outcomes." },
                    "localization": { "type": "string", "description": "Multi-language support for content and narration." },
                    "validationConstraints": { "type": "string", "description": "Field constraints and cross-field validation rules." },
                    "dynamicLogic": { "type": "string", "description": "Formulas for metric changes and AI decision trees." },
                    "advancedGameplay": { "type": "string", "description": "Deeply nested and conditional structures for advanced mechanics." },
                    "playerActions": { "type": "string", "description": "Explicit modeling of player actions and feedback loops." },
                    "simulationAlgorithms": { "type": "string", "description": "Simulation logic and algorithms for scenario progression." }
                  }
                },
            "dynamicLogic": {
              "type": "object",
              "properties": {
                "metricFormulas": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "metric": { "type": "string" },
                      "formula": { "type": "string" },
                      "inputs": { "type": "array", "items": { "type": "string" } },
                      "conditions": { "type": "string" }
                    }
                  }
                },
                "aiDecisionTrees": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "actorId": { "type": "string" },
                      "decisionTree": {
                        "type": "object",
                        "properties": {
                          "nodes": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "nodeId": { "type": "string" },
                                "condition": { "type": "string" },
                                "action": { "type": "string" },
                                "nextNode": { "type": "string" }
                              }
                            }
                          },
                          "startNode": { "type": "string" }
                        }
                      }
                    }
                  }
                }
              }
            },
            "advancedGameplay": {
              "type": "object",
              "properties": {
                "nestedStructures": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "structureName": { "type": "string" },
                      "data": { "type": "object" },
                      "conditions": { "type": "string" }
                    }
                  }
                },
                "conditionalLogic": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "condition": { "type": "string" },
                      "outcome": { "type": "string" },
                      "affectedEntities": { "type": "array", "items": { "type": "string" } }
                    }
                  }
                }
              }
            },
            "playerActions": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "actionId": { "type": "string" },
                  "name": { "type": "string" },
                  "description": { "type": "string" },
                  "parameters": { "type": "object" },
                  "effects": { "type": "object" },
                  "feedbackLoop": {
                    "type": "object",
                    "properties": {
                      "trigger": { "type": "string" },
                      "response": { "type": "string" },
                      "metricImpact": { "type": "object" }
                    }
                  }
                }
              }
            },
            "simulationAlgorithms": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "algorithmId": { "type": "string" },
                  "description": { "type": "string" },
                  "inputs": { "type": "array", "items": { "type": "string" } },
                  "logic": { "type": "string" },
                  "output": { "type": "string" }
                }
              }
            },
        "turnMechanics": {
