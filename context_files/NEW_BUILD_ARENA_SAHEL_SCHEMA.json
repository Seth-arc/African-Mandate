              "field": { "type": "string" },
              "constraint": { "type": "string" },
              "dependentField": { "type": "string" },
              "rule": { "type": "string" }
            }
          }
        },
    "gameTitle": { "type": "string" },
    "executiveSummary": { "type": "string" },
    "threatEnvironment": {
      "type": "object",
      "properties": {
