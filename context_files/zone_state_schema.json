{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "zone-state.schema.json",
    "type": "object",
    "required": [
        "territory_key",
        "zone_id"
    ],
    "properties": {
        "territory_key": {
            "type": "string",
            "enum": [
                "mali",
                "burkinaFaso",
                "niger",
                "chad",
                "mauritania"
            ]
        },
        "zone_id": {
            "type": "string",
            "minLength": 1
        },
        "insurgency": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
        },
        "status": {
            "type": [
                "string",
                "null"
            ]
        }
    },
    "additionalProperties": false
}