# Supabase (optional Experimental cloud saves; guest browser saves are the supported demo path)
#
# VITE_SUPABASE_ANON_KEY is intentionally browser-visible public demo infrastructure.
# Supabase anon keys are not backend secrets; access control is enforced by Supabase
# Auth and row-level security policies. Do not put service-role keys or other reusable
# backend credentials in any VITE_* variable.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key
